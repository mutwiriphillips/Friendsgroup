# --- Core ---
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://savings:savings@localhost:5432/savings_dev
# Use a long random string (openssl rand -hex 48). Never commit the real value.
JWT_SECRET=change-me
# 32-byte hex key used to encrypt sensitive fields at rest (openssl rand -hex 32)
FIELD_ENCRYPTION_KEY=change-me
APP_BASE_URL=http://localhost:8080
GROUP_NAME=Members Savings Group

# --- First super admin (created by `npm run seed` only if no users exist) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Safaricom Daraja  ---
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TILL=
# Random string embedded in callback URLs (openssl rand -hex 24). Safaricom callbacks are unsigned.
MPESA_CALLBACK_SECRET=

# --- Africa's Talking SMS (optional) ---
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
